margin = 0.15in
boxht = 0.5

# On the wire: the length prefix, then the zlib stream.
LENGTH: box "length" bold "4 bytes, big-endian" small wid 1.6
HEADER: box "header" bold "2 bytes" small wid 0.9
DEFLATE: box "DEFLATE body" bold "RFC 1951" small wid 1.7 fill 0x0C0003
ADLER: box "Adler-32" bold "4 bytes" small wid 0.9

# The zlib stream, bracketed above its three parts.
$by = HEADER.n.y + 0.18
line from (HEADER.w.x + 0.05, HEADER.n.y + 0.06) up 0.12 then right until even with ADLER.e - (0.05, 0) then down 0.12
text "zlib stream, RFC 1950" small at ((HEADER.w.x + ADLER.e.x) / 2, $by + 0.15)
line from (LENGTH.w.x + 0.05, LENGTH.n.y + 0.06) up 0.12 then right until even with LENGTH.e - (0.05, 0) then down 0.12
text "capacity, not a check" small at (LENGTH.x, $by + 0.15)

# Decoded: the card text, under the body it inflates from.
CARDS: box "card text" bold "pragma client-version …" mono small wid 1.7 with .n at DEFLATE.s + (0, -0.55)
arrow from DEFLATE.s to CARDS.n
text "inflate" small ljust at (DEFLATE.x + 0.12, (DEFLATE.s.y + CARDS.n.y) / 2)
