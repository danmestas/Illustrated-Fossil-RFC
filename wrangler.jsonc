{
  // The built site is served as static assets. The Worker script runs for
  // whatever no asset answers, which includes a sync request to /NAME, and
  // first for /repos/*: one Durable Object per draft holds its repository and
  // serves Fossil's sync protocol for it (worker/index.js). The accounts that
  // may push are the secret FOSSIL_PUSHERS, one "login:password" per line.
  // `wrangler deploy` runs the build first: the site into dist/, and the
  // sync server's WebAssembly into worker/.
  "name": "illustrated-fossil-rfc",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-28",
  "build": { "command": "node build.js dist && node worker/unpack.js" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/repos/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "REPO", "class_name": "FossilRepo" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FossilRepo"] }],
  "observability": {
    "enabled": true
  }
}
